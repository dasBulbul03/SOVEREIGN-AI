# Application
APP_ENV=development
APP_NAME=SOVEREIGN AI
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
AUTH_COOKIE_NAME=sovereignforge_session
AUTH_SESSION_HOURS=168
APP_EGRESS_ENFORCED=true
EGRESS_PROBE_TARGET=https://example.com
EGRESS_PROBE_TIMEOUT_SECONDS=3

# PostgreSQL / Qdrant (Docker Compose defaults)
POSTGRES_DB=sovereignforge
POSTGRES_USER=sovereignforge
POSTGRES_PASSWORD=sovereignforge_dev
DATABASE_URL=postgresql+psycopg://sovereignforge:sovereignforge_dev@postgres:5432/sovereignforge
QDRANT_URL=http://qdrant:6333

# Development-only pgAdmin UI (`docker-compose --profile development up -d pgadmin`)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=sovereignforge_pgadmin_dev

# Native Ollama is recommended on Apple Silicon for Metal acceleration.
OLLAMA_BASE_URL=http://host.docker.internal:11434
GENERAL_MODEL=qwen3:1.7b
CODING_MODEL=qwen2.5-coder:1.5b
EMBEDDING_MODEL=nomic-embed-text
VISION_MODEL=gemma3:4b
MODEL_KEEP_ALIVE=2m
MODEL_CONTEXT_TOKENS=8192
MODEL_HEALTH_TTL_SECONDS=30
DATA_ROOT=/app/data
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=100
OCR_TEXT_THRESHOLD=40
VISION_MAX_PAGES_PER_TASK=4
VISION_RENDER_DPI=144
MAX_IMAGE_PIXELS=25000000
QDRANT_COLLECTION=sovereignforge_chunks
CHUNK_SIZE_CHARS=2800
CHUNK_OVERLAP_CHARS=400
TASK_MAX_STEPS=30
TASK_MAX_RETRIES=2
TASK_TIMEOUT_SECONDS=180
TOOL_TIMEOUT_SECONDS=30
MAX_TOOL_OUTPUT_CHARS=12000
TASK_DIRECT_READ_CHARS=10000
TASK_EPHEMERAL_MAX_CHUNKS=128
TASK_EMBEDDING_BATCH_SIZE=8
TASK_KB_HITS_PER_BASE=5
TASK_EVIDENCE_MAX_HITS=10
TASK_EVIDENCE_MAX_CHARS=24000
TASK_EVIDENCE_TIMEOUT_SECONDS=120

# Day 4 isolated coding sandbox
SANDBOX_RUNNER_URL=http://sandbox-runner:8090
SANDBOX_RUNNER_TOKEN=sandbox-dev-token
SANDBOX_TEST_COMMAND=pytest
SANDBOX_TIMEOUT_SECONDS=45
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_COUNT=1
SANDBOX_PIDS_LIMIT=64
SANDBOX_MAX_OUTPUT_BYTES=200000
SANDBOX_MAX_REPOSITORY_BYTES=10485760
SANDBOX_MAX_FILES=200
SANDBOX_MAX_PATCH_CHARS=100000
SANDBOX_REPOSITORY_CONTEXT_CHARS=32000
SANDBOX_MAX_ATTEMPTS=6

# M1 8 GB safety defaults
MAX_CONCURRENT_MODEL_REQUESTS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
